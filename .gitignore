# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# ─── OS ───────────────────────────────────────────────────
.DS_Store

# ─── Local Claude settings (machine-specific) ─────────────
.claude/settings.local.json

# ════════════════════════════════════════════════════════════
#  GENERATED DATA — never commit (regenerated by the pipeline)
# ════════════════════════════════════════════════════════════

# Raw + enriched video analyses
*.analysis.json
*.pass1.analysis.json
*.enriched.json
enriched/

# DJ-set audio analyses, lyrics, build artifacts, outputs
sets/
*.deep-analysis.json
*.lyrics.json
*_mv_build/
demucs_output/

# Text-scan + vision-contest artifacts
text_flags/
vision_contest/

# Bake-off run artifacts (extracted frames, per-engine raw, scores, manifests, state).
# The bench/ code and any hand-labeled bench/groundtruth/*.json are kept.
bench/results/

# MMR + audit runtime artefacts (re-generated each run)
bench/mmr_diagnostics.log
phase0_repeat_audit*.txt

# Local copies of source footage staged for fast benchmarking (also covered by the
# media extensions above, but listed explicitly).
raw_footage/

# Manifests / audit summaries
_manifest.json
_audit_summary.json
*_batch_manifest.json
analysis_output/

# Media files (sources, stems, renders)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.flac
*.m4a
*.aac

# ─── Keep small, committed example outputs ────────────────
!examples/
!examples/*.json
